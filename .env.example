# Copiar como .env para desarrollo local. NUNCA subir .env al repositorio.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATA_DIR: dejar sin definir en local (usa datos_locales/). En Render: /var/data

# Correo (formulario de contacto). Gmail: usar una "contraseña de aplicación".
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
CONTACTO_DESTINATARIOS=
# En local, para ver los correos en la consola en lugar de enviarlos:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
